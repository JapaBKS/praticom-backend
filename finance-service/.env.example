# Copie para .env e preencha (cp .env.example .env). Na Azure, crie as mesmas chaves em Configuração > Variáveis de ambiente.
PORT=5002
# Mesma chave usada no Gateway/BFF; sem ela o serviço recusa chamadas (HTTP 401).
INTERNAL_API_KEY=troque-esta-chave
# Azure SQL Database (string ADO.NET copiada do portal, com a senha preenchida). Vazio = memória.
SQL_CONNECTION_STRING=Server=tcp:praticom-sql.database.windows.net,1433;Initial Catalog=praticom_finance;User ID=praticomadmin;Password=SUA_SENHA;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
# Azure Service Bus: mesma fila em que o Mercadinho publica. Vazio = aceita eventos por POST /internal/events (local).
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://praticom-bus.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
SERVICEBUS_QUEUE=market-sale-condo-bill
# Fuso usado para calcular "vencido".
TIMEZONE=America/Sao_Paulo
