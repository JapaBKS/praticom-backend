# Copie para .env e preencha (cp .env.example .env). Na Azure, crie as mesmas chaves em Configuração > Variáveis de ambiente.
PORT=5001
# Mesma chave usada no Gateway/BFF; sem ela o serviço recusa chamadas (HTTP 401).
INTERNAL_API_KEY=troque-esta-chave
# MongoDB Atlas (Free Tier M0). Vazio = armazenamento em memória (só para teste local).
MONGODB_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=praticom_market
# Azure Service Bus: connection string do namespace e nome da fila.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://praticom-bus.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
SERVICEBUS_QUEUE=market-sale-condo-bill
# Só para rodar local SEM Service Bus: entrega o evento direto no Financeiro por HTTP.
FINANCE_DEV_URL=
